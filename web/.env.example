# Copiá este archivo como .env y completá los valores reales.
# Vite solo expone al navegador las variables que empiezan con VITE_.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Usá la anon/publishable key, NUNCA la service_role (esta viaja al navegador).
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL del middleware de red
VITE_API_URL=http://localhost:4000

# Modo demo: permite recorrer la interfaz sin Supabase ni equipos de red.
# Datos de ejemplo en memoria, se pierden al recargar. Dejar en false para uso real.
VITE_DEMO_MODE=false
