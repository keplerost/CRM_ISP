[Unit]
Description=Taller SmartOLT - middleware de red (OLT SSH / MikroTik API)
Documentation=file:/opt/smartolt/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smartolt
Group=smartolt
WorkingDirectory=/opt/smartolt/middleware
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5

# Escucha solo en loopback: se llega por nginx en /api, nunca directo desde internet.
Environment=NODE_ENV=production

# Endurecimiento. El middleware solo necesita leer su propio directorio.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/smartolt/middleware
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=smartolt

[Install]
WantedBy=multi-user.target
