# =============================================================================
# Ambiente de PRUEBA — copiar a .env.prueba y completar
# =============================================================================
# Se arranca con:  npm run dev:prueba
#
# ── Lo único que de verdad importa ──
#
# Que SUPABASE_URL apunte a OTRO proyecto. Todo lo demás de este archivo es
# comodidad; eso es lo que evita que una prueba sea una operación real.
#
# El sistema cobra: acredita pagos, salda facturas, corta y reconecta abonados.
# Una prueba contra la base de producción no es una prueba.
# =============================================================================


# Otro puerto, para que pueda convivir con el de producción en la misma máquina.
PORT=4900

CORS_ORIGIN=http://localhost:5273


# --- La base de PRUEBA -------------------------------------------------------
# Supabase → el proyecto NUEVO → Project Settings → API
#
# Verificalo dos veces. Es la única línea de este archivo capaz de arruinar algo.
SUPABASE_URL=https://EL-PROYECTO-DE-PRUEBA.supabase.co
SUPABASE_SERVICE_ROLE_KEY=


# --- Cifrado de credenciales de equipos --------------------------------------
# Propia, distinta de la de producción. Las contraseñas de OLTs y MikroTiks que
# se carguen acá quedan cifradas con esta llave y no sirven allá — que es
# exactamente lo que se busca: dos ambientes que no puedan tocarse entre sí.
#
# Generá una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_KEY=


REQUIRE_AUTH=true


# --- Sesiones SSH ------------------------------------------------------------
# Los mismos que producción: si se prueban tiempos distintos, no se está
# probando lo que después va a correr.
SSH_IDLE_MS=800
SSH_COMMAND_TIMEOUT_MS=45000
SSH_CONNECT_TIMEOUT_MS=15000


# --- Automatismos: APAGADOS --------------------------------------------------
# En false, sin excepción.
#
# El ambiente de prueba comparte los equipos de red con producción —no hay
# MikroTik de mentira—, así que un corte automático disparado desde acá corta
# a un abonado de verdad.
CORTES_AUTOMATICOS=false
CORTES_HORA=
CORTES_LIMITE=0


# --- Portal del abonado ------------------------------------------------------
# Vacío a propósito: sin esta línea el botón "Ingresar a mi cuenta" no se dibuja
# en los correos. En pruebas es lo que se quiere.
# PORTAL_URL=


# --- GenieACS ----------------------------------------------------------------
# Vacío salvo que estés probando específicamente TR-069.
GENIEACS_URL=


# =============================================================================
# Lo que NO se configura acá y hay que revisar igual
# =============================================================================
#
# La vía de WhatsApp y el correo NO viven en este archivo: están en la base, en
# `config_mensajeria`. Al crear el proyecto de prueba arrancan vacíos, y así hay
# que dejarlos.
#
#   Ajustes → Mensajería → vía de WhatsApp: MANUAL
#   Ajustes → Mensajería → correo: sin credenciales
#
# Es lo que más se olvida y lo más caro: un aviso de corte de prueba enviado a
# 180 abonados reales cuesta el número de WhatsApp, no una disculpa.
# =============================================================================
