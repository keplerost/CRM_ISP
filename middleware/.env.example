# Copiá este archivo como .env y completá los valores reales.
# El .env NO se versiona (está en .gitignore).

# Puerto en el que escucha el middleware
PORT=4000

# Origen del frontend permitido por CORS (separar con comas si hay varios)
CORS_ORIGIN=http://localhost:5173

# --- Supabase ---------------------------------------------------------------
# La service_role key BYPASSEA RLS. Nunca la pongas en el frontend.
# Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Cifrado de credenciales de equipos -------------------------------------
# Passphrase con la que se cifran/descifran las contraseñas de OLTs y MikroTiks
# guardadas en Supabase (AES-256-GCM). Si la cambiás, las credenciales ya
# guardadas dejan de poder descifrarse y hay que volver a cargarlas.
CREDENTIALS_KEY=cambiame-por-una-frase-larga-y-aleatoria

# Exigir el access token de Supabase en cada request (recomendado dejarlo en true).
# Ponelo en false solo para probar con curl/Postman durante el taller.
REQUIRE_AUTH=true

# --- Comportamiento de las sesiones SSH --------------------------------------
# Milisegundos de silencio en la salida para considerar que un comando terminó
SSH_IDLE_MS=600
# Timeout total por comando
SSH_COMMAND_TIMEOUT_MS=15000
# Timeout de conexión
SSH_CONNECT_TIMEOUT_MS=15000

# --- Corte automático de promesas de pago vencidas ---------------------------
# Cuando una promesa vence sin pago, el abonado quedó habilitado sin haber
# pagado. Con esto en true, el middleware lo corta solo una vez al día.
# Solo corta a quien SIGUE debiendo: si pagó, queda afuera aunque nadie haya
# cerrado la promesa a mano.
CORTES_AUTOMATICOS=false
# Hora del corte, en la hora del servidor (HH:MM)
CORTES_HORA=09:00
# Tope de cortes por corrida. Es la red de seguridad ante una consulta que
# devuelva de más: nunca deja sin internet a más que esto de una vez.
CORTES_LIMITE=200

# --- Generación mensual de facturas ------------------------------------------
# Crea la factura del sistema de cada abonado en su día de facturación.
# No emite nada ante el SRI: eso se revisa y se envía aparte.
FACTURACION_AUTOMATICA=false
FACTURACION_HORA=06:00

# --- Monitoreo de red (NMS / Watchdog) ---------------------------------------
# Sondea los nodos de la red y avisa cuando algo se cae o se recupera.
#
# Apagado por defecto, y acá el motivo es propio: encenderlo antes de cargar las
# dependencias padre/hijo hace que el primer corte de fibra en una torre mande
# un mensaje por cada antena que cuelga de ella. A partir de ahí nadie los lee.
# Se enciende cuando el inventario ya tiene el árbol armado.
NMS_AUTOMATICO=false
# Cada cuántos minutos se sondea todo.
NMS_CADA_MINUTOS=2
# Pings por sondeo. Con menos, una pérdida puntual se lee como caída.
NMS_PAQUETES=4
# Por dónde salen los avisos: telegram | whatsapp | sms | email
# AHORA SE CONFIGURA EN Ajustes → Mensajería. Esto queda como valor de arranque:
# lo que se cargue desde la pantalla gana.
NMS_CANAL=telegram
# A dónde avisar cuando el nodo no tiene técnico asignado. Para Telegram es el
# chat_id del grupo del NOC; para SMS o WhatsApp, un número.
NMS_DESTINO=

# ─── Mensajería ───────────────────────────────────────────────────────────────
# Las credenciales de los canales AHORA VIVEN EN LA BASE, cifradas, y se cargan
# desde Ajustes → Mensajería. Este sistema se vende: el ISP que lo compra tiene
# su propio bot y su propio número, y no puede necesitar una sesión SSH.
#
# Estas variables siguen funcionando como valor de arranque, para que las
# instalaciones que ya existían no se queden sin avisos al actualizar. Lo que se
# cargue desde la pantalla gana sobre lo que esté acá.
#
# TELEGRAM_BOT_TOKEN=      El que da @BotFather
# WHATSAPP_TOKEN=          API de WhatsApp Business (Meta)
# WHATSAPP_PHONE_ID=       El Phone Number ID, no el teléfono
# WHATSAPP_VERIFY_TOKEN=   El del saludo de alta del webhook. Lo inventás vos y
#                          va igual acá y en el panel de Meta.
# WHATSAPP_APP_SECRET=     El App Secret de la app de Meta. Con él se verifica la
#                          firma de cada webhook que llega. SIN ESTO, las bajas
#                          que el abonado pide por chat NO se aplican: cualquiera
#                          que descubra la URL podría mandar una "BAJA" falsa y
#                          dejar a un abonado sin enterarse de que le van a cortar.
# TWILIO_SID=              SMS, y WhatsApp si se elige esa vía
# TWILIO_TOKEN=
# TWILIO_FROM=

# --- Sesión SSH de las OLTs --------------------------------------------------
# Reutilizar una sola sesión entre operaciones en vez de abrir y cerrar una por
# cada acción. Sin esto, escanear un puerto, leer potencia y registrar una ONU
# son tres logins y tres logouts seguidos: en el registro del equipo se ve una
# entrada y una salida por clic, y una OLT que admite tres sesiones queda a un
# paso del "exceed max sessions".
#
# El precio: si el middleware se cae de golpe, la sesión abierta puede quedar
# colgada del lado del equipo hasta que la libere su propio timeout. Se cierran
# al apagar el proceso, y con POST /api/olt/sesiones/cerrar a demanda.
SSH_SESION_PERSISTENTE=true
# Cuánto se mantiene abierta sin uso antes de soltar la ranura del equipo.
# TIENE que ser menor que el timeout de sesión configurado en la OLT: si el
# equipo la mata primero, la próxima operación intenta reutilizar una sesión
# muerta y termina tardando más que abrir una nueva.
SSH_SESION_IDLE_MS=45000

# ─── Licencia ─────────────────────────────────────────────────────────────────
# El sistema se vende por abonado y se cobra por mes. Estas tres líneas son lo
# que la instalación necesita para verificar su permiso.

# La clave PÚBLICA del proveedor. Con esta se verifica la firma; para emitir
# licencias hace falta la privada, que nunca sale de la máquina del proveedor.
# Se genera con: node scripts/licencia.mjs claves
#
# VACÍA = ESTA COPIA NO ESTÁ BAJO LICENCIA. Funciona sin límite ni vencimiento.
# Es lo correcto para la instalación del propio proveedor y para desarrollo: sin
# ese interruptor, actualizar a esta versión bloquearía en el acto cualquier
# instalación existente. Se completa recién al entregarle una copia a un cliente.
LICENCIA_CLAVE_PUBLICA=

# A dónde pedir la renovación diaria. Vacío = solo licencias pegadas a mano en
# Ajustes → Licencia, que es como se arranca antes de tener el servidor.
LICENCIA_SERVIDOR=

# Días de margen tras el vencimiento antes de bloquear. Absorbe el pago hecho
# un viernes a la tarde que se acredita el lunes: sin margen, el cliente que
# pagó en fecha igual amanece bloqueado y la llamada la atiende el proveedor.
LICENCIA_GRACIA_DIAS=3

# ─── Servidor TR-069 (GenieACS) ───────────────────────────────────────────────
# Es lo único que puede tocar el WiFi de la ONT del abonado: la OLT sabe darle
# servicio, pero el nombre de la red y su clave viven dentro del equipo.
#
# Va el NBI (la API), no la interfaz web. Por defecto GenieACS lo expone en 7557.
#
# VACÍO = sin TR-069. Los cambios de WiFi que pida el abonado quedan pedidos y
# alguien los aplica a mano desde Ajustes → Portal del cliente.
GENIEACS_URL=

# Corto a propósito: si el ACS no contesta rápido es porque no llega al equipo, y
# hacer esperar al abonado treinta segundos para decirle que quedó pendiente es
# peor que decírselo enseguida.
GENIEACS_TIMEOUT_MS=8000
